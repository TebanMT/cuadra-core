[Unit]
Description=Tinta Server (cloud API)
Documentation=https://github.com/esteban/cuadra-core
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=tinta
Group=tinta
WorkingDirectory=/opt/tinta
ExecStart=/opt/tinta/bin/tinta-server
EnvironmentFile=/opt/tinta/tinta-server.env

# Restart policy — si el binario crashea, reintenta cada 5s.
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

# Logs — al journal, capturable con `journalctl -u tinta-server -f`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tinta-server

# Hardening (defense in depth — el proceso no necesita más que su workdir).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tinta /var/log/tinta
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

# Límites razonables para un CX33 (8 GB RAM).
LimitNOFILE=65536
MemoryMax=4G

[Install]
WantedBy=multi-user.target
