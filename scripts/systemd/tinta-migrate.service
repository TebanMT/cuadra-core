[Unit]
Description=Tinta schema migration (separate database owner)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=tinta-migrator
Group=tinta-migrator
WorkingDirectory=/opt/tinta
EnvironmentFile=/etc/tinta/migrate.env
ExecStart=/opt/tinta/bin/tinta-migrate --dir /opt/tinta/migrations
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=300
