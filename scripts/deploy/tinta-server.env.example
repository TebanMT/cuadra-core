# tinta-server.env — environment del binario en producción.
#
# Se monta en /opt/tinta/tinta-server.env, lo lee systemd vía
# EnvironmentFile. Permisos: 600, owner tinta:tinta.
#
# Generación de secretos (en tu laptop):
#
#   JWT_SECRET:        openssl rand -base64 64 | tr -d '\n'
#   TINTA_SMK_BASE64: openssl rand -base64 32
#   DB password:       openssl rand -base64 32 | tr -d '/+=' | head -c 32
#
# IMPORTANTE: no lo commits. Solo este `.example` vive en git.

# ── App ────────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production
PUBLIC_BASE_URL=https://api.entinta.app

# CORS — el dashboard productivo + landing.
CORS_ALLOWED_ORIGINS=https://entinta.app,https://entinta.mx

# ── Postgres ───────────────────────────────────────────────────────
# El servidor escucha solo en localhost (no expuesto vía ufw).
DATABASE_URL=postgresql://tinta:CHANGE_ME@127.0.0.1:5432/tinta?sslmode=disable

# Path absoluto al directorio con las migraciones SQL.
# CRÍTICO en producción: el binario corre con WorkingDirectory=/opt/tinta
# (lo setea systemd), pero el directorio de migraciones se planta en
# /opt/tinta/migrations/ (lo hace 02-deploy-binary.sh con rsync). El default
# del código es "db_migrations/postgres" relativo, que asume corrida desde
# la raíz del repo — en prod no aplica.
MIGRATIONS_DIR=/opt/tinta/migrations

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_BYTE_RANDOM
TINTA_SMK_BASE64=CHANGE_ME_32_BYTE_BASE64

# ── Trial / billing ────────────────────────────────────────────────
TRIAL_DURATION_DAYS=30

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PLUS=

MP_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MP_AMOUNT_STANDARD=799
MP_AMOUNT_PLUS=1599

BILLING_SUCCESS_URL=https://entinta.app/settings/billing?status=ok
BILLING_CANCEL_URL=https://entinta.app/settings/billing?status=cancel

# ── Email (Resend en prod) ────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@entinta.mx
RESEND_API_KEY=

# ── WhatsApp (Twilio en prod cuando esté listo) ───────────────────
WHATSAPP_PROVIDER=stdout
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=https://api.entinta.app/api/v1/webhooks/twilio

# ── Workers ───────────────────────────────────────────────────────
NOTIFICATIONS_DISPATCH_INTERVAL_S=5
NOTIFICATIONS_EXPIRY_INTERVAL_M=60
