# cuadra-server.env — environment del binario en producción.
#
# Se monta en /opt/cuadra/cuadra-server.env, lo lee systemd vía
# EnvironmentFile. Permisos: 600, owner cuadra:cuadra.
#
# Generación de secretos (en tu laptop):
#
#   JWT_SECRET:        openssl rand -base64 64 | tr -d '\n'
#   CUADRA_SMK_BASE64: openssl rand -base64 32
#   DB password:       openssl rand -base64 32 | tr -d '/+=' | head -c 32
#
# IMPORTANTE: no lo commits. Solo este `.example` vive en git.

# ── App ────────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production
PUBLIC_BASE_URL=https://api.cuadra.app

# CORS — el dashboard productivo + landing.
CORS_ALLOWED_ORIGINS=https://app.cuadra.app,https://cuadra.app

# ── Postgres ───────────────────────────────────────────────────────
# El servidor escucha solo en localhost (no expuesto vía ufw).
DATABASE_URL=postgresql://cuadra:CHANGE_ME@127.0.0.1:5432/cuadra?sslmode=disable

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_BYTE_RANDOM
CUADRA_SMK_BASE64=CHANGE_ME_32_BYTE_BASE64

# ── Trial / billing ────────────────────────────────────────────────
TRIAL_DURATION_DAYS=30

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PLUS=

MP_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MP_AMOUNT_STANDARD=799
MP_AMOUNT_PLUS=1599

BILLING_SUCCESS_URL=https://app.cuadra.app/settings/billing?status=ok
BILLING_CANCEL_URL=https://app.cuadra.app/settings/billing?status=cancel

# ── Email (Resend en prod) ────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@cuadra.app
RESEND_API_KEY=

# ── WhatsApp (Twilio en prod cuando esté listo) ───────────────────
WHATSAPP_PROVIDER=stdout
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=https://api.cuadra.app/api/v1/webhooks/twilio

# ── Workers ───────────────────────────────────────────────────────
NOTIFICATIONS_DISPATCH_INTERVAL_S=5
NOTIFICATIONS_EXPIRY_INTERVAL_M=60
