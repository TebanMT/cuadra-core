# Server (cloud)
PORT=8080
ENVIRONMENT=development
DATABASE_URL=postgresql://cuadra:cuadra_dev@localhost:5432/cuadra?sslmode=disable
JWT_SECRET=change-me-in-production-use-a-256-bit-random-secret

# Sidecar (local)
SIDECAR_PORT=9090
SIDECAR_DB_PATH=./tmp/cuadra.db

# Trial duration in days (UC-001 step 1)
TRIAL_DURATION_DAYS=30

# Email provider (MVP: stdout logger; V1.0: Resend or SES)
EMAIL_PROVIDER=stdout
EMAIL_FROM=noreply@cuadra.app
RESEND_API_KEY=

# WhatsApp provider (MVP: stdout logger; V1.0: Twilio)
WHATSAPP_PROVIDER=stdout
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Cloud-only: server master key for biometric template encryption (ADR-006 §2.3).
# Base64-encoded 32 bytes. Generate with: openssl rand -base64 32
# In production: secret of GitHub Actions / env var of host. Never in disk.
CUADRA_SMK_BASE64=
