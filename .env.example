#MODE=/dev/test/production
# dev = shows all features
# test = shows only features for the current plan
# production = shows only features for the current plan
TINTA_MODE=dev

# Server (cloud)
PORT=8080
ENVIRONMENT=development
DATABASE_URL=postgresql://tinta:tinta_dev@localhost:5432/tinta?sslmode=disable
JWT_SECRET=change-me-in-production-use-a-256-bit-random-secret

# Sidecar (local)
SIDECAR_PORT=9090
SIDECAR_DB_PATH=./tmp/cuadra.db

# Trial duration in days (UC-001 step 1)
TRIAL_DURATION_DAYS=30

# Email provider — values: stdout | smtp | resend | mock.
# stdout (default) logs to terminal; smtp uses any RFC 5321 server (Zoho
# Mail in prod); resend posts to https://api.resend.com.
EMAIL_PROVIDER=stdout
EMAIL_FROM=noreply@entinta.mx

# Resend (alternative provider, unused by default).
RESEND_API_KEY=

# SMTP (used when EMAIL_PROVIDER=smtp). Defaults are for Zoho Mail; use
# smtp.zoho.eu for EU-region accounts. SMTP_USER is the authenticated
# mailbox (e.g. soporte@entinta.mx); the From: header in the email is
# EMAIL_FROM, which can be a verified alias of SMTP_USER.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp provider — values: stdout | twilio | mock
# stdout (default) logs to terminal; twilio uses the official Go SDK.
WHATSAPP_PROVIDER=stdout
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número maestro de Tinta (from). E.164 sin espacios: +52 + 10 dígitos,
# p.ej. +524461057446. Se normaliza al cargar (src/shared/phone), pero
# escríbelo limpio para evitar dudas.
TWILIO_WHATSAPP_NUMBER=
# Public URL Twilio posts StatusCallbacks to. Must match the URL configured
# in the Twilio console / Messaging Service. Defaults to PUBLIC_BASE_URL +
# /api/v1/webhooks/twilio when unset.
TWILIO_WEBHOOK_URL=
# Mapping de template keys de Cuadra → Content SID (HX...) aprobado por Meta
# en Twilio. Formato: key1=HXabc,key2=HXdef (CSV con `=`). Sin esto el
# provider cae a freeform y Twilio rechaza fuera de la ventana 24h. Usa la
# clave del CÓDIGO (template.DefaultLibrary), NO el friendly-name de Twilio:
# los welcomes Media son member_welcome_number y operator_welcome_pin. Llaves
# que esperamos hoy: expiry_reminder_3d, expiry_reminder_today,
# expiry_reminder_5d_post, receipt_membership, receipt_product,
# member_welcome_number, operator_welcome_pin, owner_welcome,
# whatsapp_connect_otp, broadcast_freeform, owner_alert_low_stock,
# owner_alert_expired_batch, owner_alert_cash_close_diff,
# owner_alert_vip_no_visit, owner_alert_no_payments_today,
# oxxo_renewal_reminder_30d, oxxo_renewal_reminder_14d,
# oxxo_renewal_reminder_3d, oxxo_renewal_reminder_today.
TWILIO_CONTENT_SIDS=

# Notifications BC workers (Sesión 7).
# Dispatcher tick (drains notification_queue) — seconds.
NOTIFICATIONS_DISPATCH_INTERVAL_S=5
# Expiry-reminder scheduler tick — minutes.
NOTIFICATIONS_EXPIRY_INTERVAL_M=60

# Public base URL of the cloud API (used to compose Twilio webhook URL).
PUBLIC_BASE_URL=https://api.cuadra.app

# Public origin of the React dashboard. Used to build the password-reset
# link in the recovery email (→ /auth/reset-password). Must be the
# dashboard host, NOT the API.
DASHBOARD_BASE_URL=http://localhost:5174

# Cloud-only: server master key for biometric template encryption (ADR-006 §2.3).
# Base64-encoded 32 bytes. Generate with: openssl rand -base64 32
# In production: secret of GitHub Actions / env var of host. Never in disk.
TINTA_SMK_BASE64=

# ─── Subscription billing (Fase 1) ────────────────────────────────────────
# Stripe MX. Create the products + prices in https://dashboard.stripe.com.
# Use price IDs (price_…) NOT product IDs.
#
# Setup recomendado en el dashboard:
#   1. Products → Add product → "Tinta Standard".
#   2. Add price → recurring → monthly → MXN 799 → nickname "standard_monthly".
#      → STRIPE_PRICE_STANDARD.
#   3. Add price (same product) → recurring → yearly → MXN 7,200 → nickname
#      "standard_annual". → STRIPE_PRICE_STANDARD_ANNUAL. El descuento de
#      ~25% vs 12×mensual es deliberado (psicología "pago anual ≈ pago único"
#      y cash flow predecible para Tinta). Ver v0.2 changelog en CUADRA-SPEC.
#   4. (Próximamente) Product "Tinta Plus" → STRIPE_PRICE_PLUS. No vendible
#      hoy, pero el price ID puede pre-crearse.
#
# El nickname importa: parseStripeEvent lo lee del payload del webhook para
# decidir el plan resultante (standard_monthly vs standard_annual). Si lo
# dejas vacío, el parser cae al default "standard_monthly".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=               # price_… recurring monthly — $799 MXN/mes
STRIPE_PRICE_STANDARD_ANNUAL=        # price_… recurring yearly  — $7,200 MXN/año
# Price ONE-TIME (NO recurring) por $7,200 MXN, sólo para el flow de OXXO.
# Stripe no soporta OXXO en mode=subscription, así que el anual con OXXO
# usa mode=payment + este price. Setup:
#   Product "Tinta Standard" → Add price → One-time → MXN 7,200 →
#   nickname "standard_annual_oxxo". Renovaciones las dispara un cron del
#   cloud (envía link de checkout nuevo 30 días antes del vencimiento).
# También requiere habilitar OXXO como payment method en Stripe MX:
#   Settings → Payment methods → activar OXXO (sólo MX).
STRIPE_PRICE_STANDARD_ANNUAL_OXXO=   # price_… one-time          — $7,200 MXN
STRIPE_PRICE_PLUS=                   # price_… recurring monthly — $1,599 MXN/mes (no vendible aún)

# Mercado Pago. Production access token from https://www.mercadopago.com.mx/developers.
# AmountStandard / AmountPlus are charged monthly via /preapproval (MXN).
#
# Nota: MP_AMOUNT_STANDARD_ANNUAL queda documentado pero NO se cablea hoy.
# La API de MP `/preapproval` no documenta soporte claro para
# `auto_recurring.frequency_type=years` (sólo `months` y `days` aparecen en
# los ejemplos públicos). Antes de inventar el flow anual por MP, dejamos
# el plan "standard_annual" bloqueado en MP → ErrUnsupportedPlan; el dueño
# que quiera anual usa Stripe (que sí lo soporta nativo).
MP_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MP_AMOUNT_STANDARD=799
MP_AMOUNT_STANDARD_ANNUAL=7200   # documentado; no se cablea (MP anual bloqueado)
MP_AMOUNT_PLUS=1599
MP_BACK_URL=             # optional override; defaults to BILLING_SUCCESS_URL

# Where Stripe / MP redirect the gym owner back after the checkout flow.
# Default = PUBLIC_BASE_URL + /settings/billing?status=…  but this is the
# *cloud* base, which is fine for the redirect target since the FE picks up
# subscription state from the webhook regardless.
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=


CORS_ALLOWED_ORIGINS=*

TINTA_CLOUD_URL="http://localhost:8080"

MIGRATIONS_DIR=
# ─── Cloudflare R2 — fotos de socios (Fase 1) ──────────────────────────────
# El cloud mintea presigned URLs (PUT para subir, GET para bajar); el
# sidecar de cada gym habla con R2 directamente usando esas URLs firmadas.
# El bucket debe ser PRIVADO — las fotos son PII de socios y un URL público
# filtrado (logs, capturas) sería accesible para siempre.
#
# El FE del desktop NUNCA habla con R2; las fotos se sirven desde el cache
# local del sidecar.
#
# Setup en Cloudflare:
#   1. R2 → Create bucket (ej. "tinta-media")
#   2. R2 → Manage API Tokens → Create token con Object R&W al bucket
#   3. NO habilitar Public Access ni custom domain — bucket privado.
#
# Vacío = endpoint POST /api/v1/uploads/presign devuelve 501. El sidecar
# sigue cacheando las fotos en disco; el upload se reintenta cuando estas
# variables aparezcan.
R2_ACCOUNT_ID=             # 32 hex chars, sidebar del dashboard
R2_ACCESS_KEY=             # Access Key ID del token
R2_SECRET_KEY=             # Secret Access Key del token (sólo se ve una vez)
R2_BUCKET=                 # nombre del bucket PRIVADO de fotos (ej. tinta-media)

# ─── R2 público — WhatsApp media (ADR-009) ─────────────────────────────────
# Bucket PÚBLICO separado para los banners de bienvenida (PIN horneado en la
# imagen) que Twilio/Meta descargan anónimamente.
#   1. R2 → Create bucket "public-media-tinta"
#   2. Settings del bucket → Public access → habilitar r2.dev managed domain
#      (o conectar un dominio propio tipo media.entinta.mx)
#   3. Pegar ese dominio público en R2_PUBLIC_MEDIA_BASE_URL (sin slash final)
#   4. Manage API Tokens → token EXCLUSIVO de este bucket (Object R&W) →
#      pegar sus llaves en R2_PUBLIC_MEDIA_ACCESS_KEY/SECRET_KEY. Mismo
#      R2_ACCOUNT_ID. Si las dejas vacías, cae a R2_ACCESS_KEY/SECRET_KEY.
R2_PUBLIC_MEDIA_BUCKET=        # ej. public-media-tinta
R2_PUBLIC_MEDIA_BASE_URL=      # ej. https://pub-xxxx.r2.dev  ó  https://media.entinta.mx
R2_PUBLIC_MEDIA_ACCESS_KEY=    # Access Key ID del token exclusivo del bucket público
R2_PUBLIC_MEDIA_SECRET_KEY=    # Secret Access Key del token exclusivo
